{
  "name": "movynta-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "oxlint --type-aware --tsconfig tsconfig.spec.json src --ignore-pattern \"**/*.spec.ts\"",
    "check": "pnpm run typecheck && pnpm run lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "token": "node dist/cli/issue-token.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-node": "^12.3.2",
    "@nestjs/platform-ws": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/websockets": "^12.3.2",
    "@openai/agents": "^0.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3"
  }
}
