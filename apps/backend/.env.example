# Copy to apps/backend/.env and fill in values. Never commit the real .env file.
# The backend validates these values at startup and refuses to start when required ones are missing.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Comma-separated origins allowed to call the API (for example the Tauri dev server).
CORS_ORIGINS=http://localhost:1420
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_PER_MINUTE=120

# Required. At least 32 characters. Used to sign bearer tokens. Keep it server-side only.
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800

# SQLite file path (file:<path>), or :memory: for throwaway runs.
DATABASE_URL=file:./data/movynta.sqlite

# AI agents. OPENAI_API_KEY and OPENAI_MODEL are required while AGENTS_ENABLED=true.
# Never expose OPENAI_API_KEY to the React or Tauri frontend.
AGENTS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AGENTS_DISABLE_TRACING=false
AGENT_RUN_TIMEOUT_MS=300000
AGENT_MAX_TURNS=12

# Editor bridge and skills
EDITOR_REQUEST_TIMEOUT_MS=15000
SKILLS_DIR=../../skills

# Optional integrations. Both are off by default.
MCP_ENABLED=false
# JSON array, for example: [{"name":"local-tools","command":"node","args":["server.js"],"allowedTools":["read_file"]}]
MCP_SERVERS_JSON=
BLENDER_ENABLED=false
