# Optional overrides. The Windows desktop works without a .env file.
# Provider credentials are configured in the app and encrypted with Windows DPAPI.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Comma-separated origins allowed to call the API (for example the Tauri dev server).
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_PER_MINUTE=120

# Optional override (32+ characters). Otherwise generated and stored encrypted in local app data.
# AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800

# SQLite file path (file:<path>), or :memory: for throwaway runs.
# Defaults to %LOCALAPPDATA%/Movynta/movynta.sqlite.
# DATABASE_URL=file:./data/movynta.sqlite

# Configure OpenAI, Anthropic, or Google in Settings > Providers.
AGENTS_ENABLED=true
OPENAI_AGENTS_DISABLE_TRACING=true
# Active time for one run (30 minutes), and the longest silence before a run is stopped (5 minutes).
AGENT_RUN_TIMEOUT_MS=1800000
AGENT_RUN_IDLE_TIMEOUT_MS=300000
# How many times a run asks the model to finish unfinished work before it accepts the last reply.
AGENT_CONTINUATION_LIMIT=3
AGENT_MAX_TURNS=500

# Editor bridge and skills
EDITOR_REQUEST_TIMEOUT_MS=15000
SKILLS_DIR=../../skills

# Optional integrations. Both are off by default.
MCP_ENABLED=false
# JSON array, for example: [{"name":"local-tools","command":"node","args":["server.js"],"allowedTools":["read_file"]}]
MCP_SERVERS_JSON=
BLENDER_ENABLED=false
